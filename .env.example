# BITGUARD AI configuration (copy to .env). Never commit real secrets.
BITGUARD_ENV=development
BITGUARD_DATABASE_URL=postgresql+asyncpg://bitguard:bitguard@localhost:5432/bitguard
BITGUARD_REDIS_URL=redis://localhost:6379/0
BITGUARD_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
BITGUARD_ACCESS_TOKEN_MINUTES=15
BITGUARD_REFRESH_TOKEN_DAYS=7
BITGUARD_STORAGE_DIR=./storage
BITGUARD_MODEL_DIR=../ml/models
BITGUARD_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
BITGUARD_MAX_UPLOAD_MB=512
BITGUARD_CELERY_EAGER=false
BITGUARD_BOOTSTRAP_ADMIN_EMAIL=admin@bitguard.local
BITGUARD_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
POSTGRES_USER=bitguard
POSTGRES_PASSWORD=bitguard
POSTGRES_DB=bitguard
